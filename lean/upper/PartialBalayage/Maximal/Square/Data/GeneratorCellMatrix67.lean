theorem generatorCellMatrix67_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 67 ((k.val : ℤ) - 72) b =
      generatorCellMatrix67 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 67 ((k.val : ℤ) - 72) b =
        generatorCellMatrix67 k b := by
    decide +kernel
  exact h k b

