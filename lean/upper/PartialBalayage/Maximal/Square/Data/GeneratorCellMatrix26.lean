/-- All candidate entries are the actual signed generator cubic coefficients. -/
theorem generatorCellMatrix26_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 26 ((k.val : ℤ) - 72) b =
      generatorCellMatrix26 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 26 ((k.val : ℤ) - 72) b =
        generatorCellMatrix26 k b := by
    decide +kernel
  exact h k b

