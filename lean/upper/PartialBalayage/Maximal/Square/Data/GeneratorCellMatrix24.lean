/-- All candidate entries are the actual signed generator cubic coefficients. -/
theorem generatorCellMatrix24_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 24 ((k.val : ℤ) - 72) b =
      generatorCellMatrix24 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 24 ((k.val : ℤ) - 72) b =
        generatorCellMatrix24 k b := by
    decide +kernel
  exact h k b

