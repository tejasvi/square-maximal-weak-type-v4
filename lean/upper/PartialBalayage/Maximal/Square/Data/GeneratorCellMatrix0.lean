/-- All candidate entries are the actual signed generator cubic coefficients. -/
theorem generatorCellMatrix0_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 0 ((k.val : ℤ) - 72) b =
      generatorCellMatrix0 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 0 ((k.val : ℤ) - 72) b =
        generatorCellMatrix0 k b := by
    decide +kernel
  exact h k b

