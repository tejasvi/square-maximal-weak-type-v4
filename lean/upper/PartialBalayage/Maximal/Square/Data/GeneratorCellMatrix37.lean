  ![(0 / 1 : ℚ), (0 / 1 : ℚ), (0 / 1 : ℚ), (0 / 1 : ℚ)],
  ![(0 / 1 : ℚ), (0 / 1 : ℚ), (0 / 1 : ℚ), (0 / 1 : ℚ)],
  ![(0 / 1 : ℚ), (0 / 1 : ℚ), (0 / 1 : ℚ), (0 / 1 : ℚ)]
]

/-- All candidate entries are the actual signed generator cubic coefficients. -/
theorem generatorCellMatrix37_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 37 ((k.val : ℤ) - 72) b =
      generatorCellMatrix37 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 37 ((k.val : ℤ) - 72) b =
        generatorCellMatrix37 k b := by
    decide +kernel
  exact h k b

end PartialBalayage.Maximal.Square
