/-- Adds `a` to entry `j` of a row (no change out of range). -/
def rowAddAt : List ℚ → ℕ → ℚ → List ℚ
  | [], _, _ => []
  | x :: xs, 0, a => (x + a) :: xs
  | x :: xs, j + 1, a => x :: rowAddAt xs j a

/-- Adds `a` to entry `(i, j)` of a table (no change out of range). -/
def tableAddAt : List (List ℚ) → ℕ → ℕ → ℚ → List (List ℚ)
  | [], _, _, _ => []
  | r :: rs, 0, j, a => rowAddAt r j a :: rs
  | r :: rs, i + 1, j, a => r :: tableAddAt rs i j a

/-- Accumulates a list of indexed values into a table. -/
def buildTable (T : List (List ℚ)) : List (ℕ × ℕ × ℚ) → List (List ℚ)
  | [] => T
  | t :: ts => buildTable (tableAddAt T t.1 t.2.1 t.2.2) ts

/-- The lower-triangular zero table with rows `0, ..., 71`. -/
def zeroTriangle : List (List ℚ) := (List.range 72).map fun i => List.replicate (i + 1) 0

theorem length_rowAddAt (row : List ℚ) (j : ℕ) (a : ℚ) : (rowAddAt row j a).length = row.length := by
  induction row generalizing j with
  | nil => rfl
  | cons x xs ih => cases j <;> simp [rowAddAt, ih]

theorem getD_rowAddAt (row : List ℚ) (j l : ℕ) (a : ℚ) (hj : j < row.length) :
    (rowAddAt row j a).getD l 0 = row.getD l 0 + if j = l then a else 0 := by
  induction row generalizing j l with
  | nil => simp at hj
  | cons x xs ih =>
    cases j with
    | zero => cases l <;> simp [rowAddAt]
    | succ j =>
      cases l with
      | zero => simp [rowAddAt]
      | succ l => simpa [rowAddAt] using ih j l (by simpa using hj)

theorem length_tableAddAt (T : List (List ℚ)) (i j : ℕ) (a : ℚ) :
    (tableAddAt T i j a).length = T.length := by
  induction T generalizing i with
  | nil => rfl
  | cons r rs ih => cases i <;> simp [tableAddAt, ih]

theorem length_getD_tableAddAt (T : List (List ℚ)) (i j k : ℕ) (a : ℚ) :
    ((tableAddAt T i j a).getD k []).length = (T.getD k []).length := by
  induction T generalizing i k with
  | nil => rfl
  | cons r rs ih =>
    cases i with
    | zero => cases k <;> simp only [tableAddAt, List.getD_cons_zero, List.getD_cons_succ, length_rowAddAt]
    | succ i =>
      cases k with
      | zero => simp only [tableAddAt, List.getD_cons_zero]
      | succ k => simp only [tableAddAt, List.getD_cons_succ]; exact ih i k

theorem getD_tableAddAt (T : List (List ℚ)) (i j k l : ℕ) (a : ℚ) (hi : i < T.length)
    (hj : j < (T.getD i []).length) :
    ((tableAddAt T i j a).getD k []).getD l 0 =
      (T.getD k []).getD l 0 + if i = k ∧ j = l then a else 0 := by
  induction T generalizing i k with
  | nil => simp at hi
  | cons r rs ih =>
    cases i with
    | zero =>
      cases k with
      | zero => simpa [tableAddAt] using getD_rowAddAt r j l a (by simpa using hj)
      | succ k => simp [tableAddAt]
    | succ i =>
      cases k with
      | zero => simp [tableAddAt]
      | succ k => simpa [tableAddAt] using ih i k (by simpa using hi) (by simpa using hj)

theorem getD_buildTable (L : List (ℕ × ℕ × ℚ)) (T : List (List ℚ))
    (hL : ∀ t ∈ L, t.1 < T.length ∧ t.2.1 < (T.getD t.1 []).length) (k l : ℕ) :
    ((buildTable T L).getD k []).getD l 0 = (T.getD k []).getD l 0 +
      (L.map fun t ↦ if t.1 = k ∧ t.2.1 = l then t.2.2 else 0).sum := by
  induction L generalizing T with
  | nil => simp [buildTable]
  | cons t ts ih =>
    have ht := hL t (by simp)
    have hts : ∀ s ∈ ts, s.1 < (tableAddAt T t.1 t.2.1 t.2.2).length ∧
        s.2.1 < ((tableAddAt T t.1 t.2.1 t.2.2).getD s.1 []).length := by
      intro s hs
      rw [length_tableAddAt, length_getD_tableAddAt]
      exact hL s (by simp [hs])
    simp only [buildTable, List.map_cons, List.sum_cons]
    rw [ih _ hts, getD_tableAddAt T _ _ k l _ ht.1 ht.2]
    ring

theorem getD_zeroTriangle (k l : ℕ) : (zeroTriangle.getD k []).getD l 0 = 0 := by
  have hrow : ∀ x ∈ zeroTriangle.getD k [], x = 0 := by
    intro x hx
    rw [List.getD_eq_getElem?_getD] at hx
    cases h : zeroTriangle[k]? with
    | none => simp [h] at hx
    | some r =>
      simp only [h, Option.getD_some] at hx
      have hm := List.mem_of_getElem? h
      simp only [zeroTriangle, List.mem_map, List.mem_range] at hm
      obtain ⟨i, _, rfl⟩ := hm
      exact (List.mem_replicate.mp hx).2
  rw [List.getD_eq_getElem?_getD]
  cases h : (zeroTriangle.getD k [])[l]? with
  | none => rfl
  | some x => simp only [Option.getD_some]; exact hrow x (List.mem_of_getElem? h)

theorem length_getD_zeroTriangle {k : ℕ} (hk : k < 72) : (zeroTriangle.getD k []).length = k + 1 := by
  simp [zeroTriangle, List.getD_eq_getElem?_getD, hk]

/-- The accumulated orbit list is the literal table (one kernel pass over the orbit list). -/
theorem buildTable_splineOrbits : buildTable zeroTriangle splineOrbits = representativeCoefficientRows := by
  decide +kernel

/-- Every representative coefficient is the literal table entry (zero outside the table). -/
theorem representativeCoefficient_eq_rows (i j : ℕ) :
    representativeCoefficient i j = (representativeCoefficientRows.getD i []).getD j 0 := by
  rw [← buildTable_splineOrbits, getD_buildTable, getD_zeroTriangle, zero_add]
  · rfl
  · intro t ht
    have h := splineOrbits_admissible t ht
    have hz : zeroTriangle.length = 72 := by simp [zeroTriangle]
    refine ⟨by omega, ?_⟩
    rw [length_getD_zeroTriangle (by omega)]
    omega

