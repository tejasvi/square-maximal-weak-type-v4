theorem generatorCellMatrix58_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 58 ((k.val : ℤ) - 72) b =
      generatorCellMatrix58 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 58 ((k.val : ℤ) - 72) b =
        generatorCellMatrix58 k b := by
    decide +kernel
  exact h k b

