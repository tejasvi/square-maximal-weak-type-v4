theorem generatorCellMatrix63_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 63 ((k.val : ℤ) - 72) b =
      generatorCellMatrix63 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 63 ((k.val : ℤ) - 72) b =
        generatorCellMatrix63 k b := by
    decide +kernel
  exact h k b

