theorem bandLeafBlocks4_valid : ∀ i, BandLeafData.IsValid bandConstants (bandLeafBlocks4 i) := by
  have hM : ∀ i, (bandLeafBlocks4 i).MetadataValid := by
    intro i
    unfold BandLeafData.MetadataValid
    fin_cases i <;> decide +kernel
  have hL : ∀ i, 0 < BandLeafData.intLowerBound bandConstants (bandLeafBlocks4 i) := by
    intro i
    unfold BandLeafData.intLowerBound
    fin_cases i <;> decide +kernel
  exact fun i ↦ BandLeafData.isValid_of_int bandConstants (hM i) (hL i)

