/-- All candidate entries are the actual signed generator cubic coefficients. -/
theorem generatorCellMatrix10_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 10 ((k.val : ℤ) - 72) b =
      generatorCellMatrix10 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 10 ((k.val : ℤ) - 72) b =
        generatorCellMatrix10 k b := by
    decide +kernel
  exact h k b

