theorem generatorCellMatrix56_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 56 ((k.val : ℤ) - 72) b =
      generatorCellMatrix56 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 56 ((k.val : ℤ) - 72) b =
        generatorCellMatrix56 k b := by
    decide +kernel
  exact h k b

