theorem generatorCellMatrix59_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 59 ((k.val : ℤ) - 72) b =
      generatorCellMatrix59 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 59 ((k.val : ℤ) - 72) b =
        generatorCellMatrix59 k b := by
    decide +kernel
  exact h k b

