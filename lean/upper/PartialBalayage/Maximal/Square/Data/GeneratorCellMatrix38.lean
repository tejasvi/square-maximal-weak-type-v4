    splineGeneratorCellCoefficient 38 ((k.val : ℤ) - 72) b =
      generatorCellMatrix38 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 38 ((k.val : ℤ) - 72) b =
        generatorCellMatrix38 k b := by
    decide +kernel
  exact h k b

end PartialBalayage.Maximal.Square
