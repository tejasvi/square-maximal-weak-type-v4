theorem generatorCellMatrix47_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 47 ((k.val : ℤ) - 72) b =
      generatorCellMatrix47 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 47 ((k.val : ℤ) - 72) b =
        generatorCellMatrix47 k b := by
    decide +kernel
