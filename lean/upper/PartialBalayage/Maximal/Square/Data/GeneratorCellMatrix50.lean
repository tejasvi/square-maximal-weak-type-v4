/-- All candidate entries are the actual signed generator cubic coefficients. -/
theorem generatorCellMatrix50_correct (k : Fin 145) (b : Fin 4) :
    splineGeneratorCellCoefficient 50 ((k.val : ℤ) - 72) b =
      generatorCellMatrix50 k b := by
  rw [splineGeneratorCellCoefficient_eq_literal]
  have h : ∀ k : Fin 145, ∀ b : Fin 4,
      literalGeneratorCellCoefficient 50 ((k.val : ℤ) - 72) b =
        generatorCellMatrix50 k b := by
    decide +kernel
  exact h k b

