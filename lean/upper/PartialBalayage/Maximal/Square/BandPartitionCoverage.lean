/-- Every ordered non-zero cell outside the diamond is the root of a tree. -/
theorem bandPartitionTrees_root_cover : ∀ p q : Fin 72, q.val ≤ p.val → 51 ≤ p.val + q.val →
    ¬ ZeroCell (p.val : ℤ) (q.val : ℤ) →
      ∃ b : Fin 70, ∃ k : Fin 10, (bandPartitionTrees b k).root = generatorUnitRectangle p.val q.val := by
  decide +kernel

/-- The source density outside the diamond is positive on the ordered non-zero cells. -/
theorem bandDensity_pos_on_ordered_band {u v : ℝ} (hv : 0 < v) (hvu : v ≤ u) (hu : u < 72)
    (hr : 264 / 5 < u + v) (hz : ¬ ZeroCell ⌊u⌋ ⌊v⌋) : 0 < bandDensity u v := by
  have hu0 : 0 ≤ u := hv.le.trans hvu
  have hfu := Int.floor_nonneg.mpr hu0
  have hfv := Int.floor_nonneg.mpr hv.le
  let p : Fin 72 := ⟨⌊u⌋.toNat, by
    have : ⌊u⌋ < 72 := Int.floor_lt.mpr (by exact_mod_cast hu)
    omega⟩
  let q : Fin 72 := ⟨⌊v⌋.toNat, by
    have : ⌊v⌋ < 72 := Int.floor_lt.mpr (by exact_mod_cast (hvu.trans_lt hu))
    omega⟩
  have hp : ((p.val : ℕ) : ℤ) = ⌊u⌋ := by simp only [p]; omega
  have hq : ((q.val : ℕ) : ℤ) = ⌊v⌋ := by simp only [q]; omega
  have hqp : q.val ≤ p.val := by
    have := Int.floor_mono hvu
    omega
  have hsum : 51 ≤ p.val + q.val := by
    have h1 := Int.lt_floor_add_one u
    have h2 := Int.lt_floor_add_one v
    have : (50 : ℝ) < (⌊u⌋ : ℝ) + ⌊v⌋ := by linarith
    have : (50 : ℤ) < ⌊u⌋ + ⌊v⌋ := by exact_mod_cast this
    omega
  have hz' : ¬ ZeroCell ((p.val : ℕ) : ℤ) ((q.val : ℕ) : ℤ) := by rw [hp, hq]; exact hz
  obtain ⟨b, k, hroot⟩ := bandPartitionTrees_root_cover p q hqp hsum hz'
  have hcell : (generatorUnitRectangle p.val q.val).Contains u v := by
    have hfu' := Int.floor_le u
    have hfv' := Int.floor_le v
    have hlu := Int.lt_floor_add_one u
    have hlv := Int.lt_floor_add_one v
    have hpu : ((p.val : ℕ) : ℝ) = (⌊u⌋ : ℝ) := by exact_mod_cast hp
    have hqv : ((q.val : ℕ) : ℝ) = (⌊v⌋ : ℝ) := by exact_mod_cast hq
    simp only [generatorUnitRectangle, GeneratorRectangle.Contains, GeneratorRectangle.lowerU,
      GeneratorRectangle.lowerV, GeneratorRectangle.width, pow_zero, div_one, Nat.cast_zero, zero_mul,
      add_zero, Int.cast_natCast, Rat.cast_natCast, Rat.cast_add, Rat.cast_one]
    refine ⟨?_, ?_, ?_, ?_⟩ <;> linarith
  obtain ⟨⟨bb, ii⟩, hleaf⟩ := BandPartitionTree.coverage (bandPartitionTrees_valid b k)
    (hroot.symm ▸ hcell) hr
  have hContains : (bandLeafBlocks bb ii).rectangle.Contains u v := by
    rw [bandLeaf_rectangle_eq]; exact hleaf
  exact BandLeafData.positivity bandConstants_valid (bandLeafBlocks_valid bb ii) hContains
    (hv.trans_le hvu) hv hr

