theorem incomingNumerators_check :
    incomingNumerators.map (fun z : ℤ ↦ (z : ℚ)) =
      roundedRisingList 96 (87 / 40) radialIncomingNumerator 8192 := by
  decide +kernel

theorem length_incomingNumerators : incomingNumerators.length = 8192 := by
  have h := congrArg List.length incomingNumerators_check
  simpa [roundedRisingList, length_roundedRisingListAux] using h

/-- The cached coefficients as rationals. -/
def cachedIncomingList : List ℚ := incomingNumerators.map (fun z : ℤ ↦ (z : ℚ) / 2 ^ 96)

theorem length_cachedIncomingList : cachedIncomingList.length = 8192 := by
  simp [cachedIncomingList, length_incomingNumerators]

/-- Every cached coefficient equals the certificate's rounded incoming coefficient. -/
theorem getD_cachedIncomingList {n : ℕ} (hn : n < 8192) :
    cachedIncomingList.getD n 0 = radialIncomingCoefficient n := by
  have h := congrArg (fun l : List ℚ ↦ l.getD n 0) incomingNumerators_check
  rw [getD_roundedRisingList _ _ _ hn] at h
  have hl : n < incomingNumerators.length := by rw [length_incomingNumerators]; exact hn
  simp only [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hl,
    Option.map_some, Option.getD_some] at h
  unfold cachedIncomingList
  simp only [List.getD_eq_getElem?_getD, List.getElem?_map, List.getElem?_eq_getElem hl,
    Option.map_some, Option.getD_some]
  rw [h]
  rfl

end PartialBalayage.Maximal.Square
